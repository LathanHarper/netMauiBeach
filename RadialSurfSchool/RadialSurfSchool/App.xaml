<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RadialSurfSchool.App">
    <Application.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#164D4D" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinimumTrackColor" Value="#007F7B" />
            <Setter Property="MaximumTrackColor" Value="#C9D8CE" />
            <Setter Property="ThumbColor" Value="#DA5540" />
            <Setter Property="HeightRequest" Value="40" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#007F7B" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>
    </Application.Resources>
</Application>
