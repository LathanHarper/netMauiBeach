{
  "AttributesTolerance": 0,
  "KeepFirstAttributeOnSameLine": false,
  "MaxAttributeCharactersPerLine": 0,
  "MaxAttributesPerLine": 1,
  "NewlineExemptionElements": "Color, RadialGradientBrush, GradientStop, LinearGradientBrush, ScaleTransform, SkewTransform, RotateTransform, TranslateTransform, Trigger, Condition, Setter, RowDefinition, ColumnDefinition, Binding",
  "SeparateByGroups": false,
  "AttributeIndentation": 0,
  "AttributeIndentationStyle": 1,
  "RemoveDesignTimeReferences": false,
  "IgnoreDesignTimeReferencePrefix": false,
  "EnableAttributeReordering": true,
  "AttributeOrderingRuleGroups":
  [
    "IsUnlockedMode",
    "x:Class",
    "xmlns, xmlns:x",
    "xmlns:*",
    "x:Key, Key, x:Name, Name, AutomationId, x:Uid, Uid, Title, Background, BackgroundColor",
    "xamljocky:PanelBoss.PanelName, xamljocky:PanelBoss*",
    "BindingContext, x:DataType",
    "views:PopupSystem.DeviceFeedbackState, views:PopupSystem.CurrentDeviceFeedbackPathString, views:PopupSystem.PopupState, views:PopupSystem.CurrentPopupPathString, views:PopupSystem.CurrentPopupNavigationParameters",
    "IsVisible",
    "Grid.Row, Grid.RowSpan, Grid.Column, Grid.ColumnSpan, Canvas.Left, Canvas.Top, Canvas.Right, Canvas.Bottom",
    "Margin, Padding, HorizontalAlignment, VerticalAlignment, HorizontalContentAlignment, VerticalContentAlignment, Panel.ZIndex",
    "HorizontalOptions, HorizontalTextAlignment, VerticalOptions, VerticalTextAlignment",
    "Width, Height, MinWidth, MinHeight, MaxWidth, MaxHeight",
    "BackgroundDisabled,BackgroundNormal,BackgroundToggled,StrokeDisabled,StrokeNormal,StrokeToggled",
    "Source, Mode, Path",
    "*:*, *",
    "PageSource, PageIndex, Offset, Color, TargetName, Property, Value, StartPoint, EndPoint",
    "mc:Ignorable, d:IsDataSource, d:LayoutOverrides, d:IsStaticText",
    "Storyboard.*, From, To, Duration",
    "*Loaded, *Focused, *Unfocused, *TextChanged, *Completed, *Clicked, *Pressed, *Released, *Scrolled, *SelectionChanged, *SearchButtonPressed, *RemainingItemsThresholdReached",
    "InputTransparent"
  ],
  "FirstLineAttributes": "IsUnlockedMode, x:Key, Key, x:Name, Name, Title, AutomationId, PanelBossInstance, Background, BackgroundColor",
  "OrderAttributesByName": true,
  "PutEndingBracketOnNewLine": true,
  "RemoveEndingTagOfEmptyElement": false,
  "SpaceBeforeClosingSlash": true,
  "RootElementLineBreakRule": 0,
  "ReorderVSM": 2,
  "ReorderGridChildren": false,
  "ReorderCanvasChildren": false,
  "ReorderSetters": 0,
  "FormatMarkupExtension": true,
  "NoNewLineMarkupExtensions": "",
  "ThicknessSeparator": 2,
  "ThicknessAttributes": "Margin, Padding, BorderThickness, ThumbnailClipMargin",
  "FormatOnSave": false,
  "CommentPadding": 2
}