<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Semantic Colors: Dark-mode defaults for design-time; runtime swap on login  -->

    <!--  Text colors  -->
    <Color x:Key="TextPrimaryColor">White</Color>
    <Color x:Key="TextSecondaryColor">#C8C8C8</Color>
    <Color x:Key="TextDisabledColor">#404040</Color>
    <Color x:Key="TextHeadlineColor">White</Color>

    <!--  Background colors  -->
    <Color x:Key="BackgroundPrimaryColor">#1f1f1f</Color>
    <Color x:Key="BackgroundSecondaryColor">#2b2b2b</Color>
    <Color x:Key="SurfaceColor">#2b2b2b</Color>

    <!--  Accent/Brand colors  -->
    <Color x:Key="AccentPrimaryColor">#ac99ea</Color>
    <Color x:Key="AccentPrimaryTextColor">#242424</Color>

    <!--  Button colors  -->
    <Color x:Key="ButtonBackgroundColor">#ac99ea</Color>
    <Color x:Key="ButtonTextColor">#242424</Color>
    <Color x:Key="ButtonDisabledBackgroundColor">#404040</Color>
    <Color x:Key="ButtonDisabledTextColor">#C8C8C8</Color>

    <!--  Border/Stroke colors  -->
    <Color x:Key="BorderColor">#404040</Color>

</ResourceDictionary>
